  <!--
    必须关闭 NXCOMPAT（DEP）。
    原因：Cognos GRID 报表控件 griectl.dll（CLSID 9E4CCA44-17FC-402B-822C-BFA6CBA77C0C）
    在运行时把一段机器码写进普通读写内存（PAGE_READWRITE / MEM_PRIVATE）后直接跳转执行，
    即老式"动态 thunk"。进程启用 DEP 时该页不可执行，跳转即触发 c0000005 访问冲突，
    崩溃点固定在 griectl 的窗口回调里（user32!KiUserCallbackDispatcher 链路）。

    32 位 IE 本身 DllCharacteristics=0xC040（无 NXCOMPAT）所以控件在 IE 里正常，
    本程序如果带 NXCOMPAT 就会崩。因此这里显式清除该位，与 32 位 IE 保持一致。
  -->
  <Target Name="DisableNxCompat" AfterTargets="Build" Condition="Exists('$(TargetPath)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\disable-nxcompat.ps1&quot; -Path &quot;$(TargetPath)&quot;" ContinueOnError="true" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
